/* =============================================================================
   全局样式表（resources/style.qss）
   -----------------------------------------------------------------------------
   作用：统一整个应用的字体、配色与控件外观，构建类似 Windows Fluent 的浅色主题。
   加载：main.cpp 在创建主窗口前从 Qt 资源 ":/style.qss" 读取并 setStyleSheet。
   组织：按控件类型分组（基础 / 分组框 / 标签 / 拖放区 / 按钮 / 输入框 /
         下拉框 / 状态色 / 进度条 / 提示框）。同类控件优先用 objectName 精确匹配，
         避免影响无关控件。
   说明：conversionStatusLabel 使用动态属性 state（idle/ready/working/success/error）
         切换颜色，代码侧通过 setProperty + unpolish/polish 触发重新计算样式。
   ============================================================================= *//* VideoConverter Fluent-style light theme. */

/* ---------- 基础排版：全局字体族、字号与前景色 ---------- */
QWidget {
    font-family: "Microsoft YaHei UI", "Microsoft YaHei", "Segoe UI", sans-serif;
    font-size: 13px;
    color: #1f2328;
}

QWidget#Widget {
    background-color: #f5f6f8;
}

/* ---------- 分组框：白底、细边框、圆角，标题嵌入上边框 ---------- */
QGroupBox {
    background-color: #ffffff;
    border: 1px solid #d8dde4;
    border-radius: 10px;
    margin-top: 14px;
    padding: 12px 10px 10px 10px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 12px;
    padding: 0 6px;
    color: #344054;
    font-weight: 600;
    background-color: #ffffff;
}

/* ---------- 标签：默认透明背景，避免继承分组框白底后出现色块 ---------- */
QLabel {
    background: transparent;
}

QLabel#toolStatusLabel {
    color: #475467;
    font-weight: 500;
}

QLabel#thumbnailLabel {
    background-color: #1f2328;
    border: 1px solid #344054;
    border-radius: 10px;
    padding: 4px;
    color: #98a2b3;
    font-size: 13px;
}

/* ---------- 拖放区域：虚线边框 + 悬停高亮，提示可拖入 ---------- */
QFrame#dropArea {
    background-color: #ffffff;
    border: 2px dashed #b9c3cf;
    border-radius: 10px;
}

QFrame#dropArea:hover {
    background-color: #f8fbff;
    border-color: #7aa7e6;
}

QLabel#dropTitle {
    font-size: 17px;
    font-weight: 600;
    color: #1f2328;
}

QLabel#dropSubtitle {
    color: #667085;
}

QLabel#dropFormats {
    font-size: 12px;
    color: #98a2b3;
}

/* ---------- 按钮：通用样式（白底描边），随后按 objectName 特化 ---------- */
QPushButton {
    background-color: #ffffff;
    border: 1px solid #c9d1db;
    border-radius: 8px;
    padding: 6px 14px;
    min-height: 20px;
    color: #1f2328;
}

QPushButton:hover {
    background-color: #eef4ff;
    border-color: #7aa7e6;
}

QPushButton:pressed {
    background-color: #dce8ff;
    border-color: #5b8fd6;
}

QPushButton:disabled {
    background-color: #f0f2f5;
    border-color: #dde2e8;
    color: #a0a7b2;
}

QPushButton#browseButton {
    background-color: #e8f0fe;
    border-color: #b7cdf5;
    color: #1a4fa0;
    font-weight: 600;
}

QPushButton#browseButton:hover {
    background-color: #dbe8ff;
    border-color: #7aa7e6;
}

QPushButton#browseButton:pressed {
    background-color: #cfe0ff;
    border-color: #5b8fd6;
}

QPushButton#browseButton:disabled {
    background-color: #f0f2f5;
    border-color: #dde2e8;
    color: #a0a7b2;
}

QPushButton#settingsButton {
    background-color: transparent;
    border-color: transparent;
    color: #5b6472;
}

QPushButton#settingsButton:hover {
    background-color: #eceff3;
    border-color: #dde2e8;
}

QPushButton#settingsButton:pressed {
    background-color: #e2e6eb;
    border-color: #d8dde4;
}

QPushButton#settingsButton:disabled {
    background-color: transparent;
    border-color: transparent;
    color: #a0a7b2;
}

QPushButton#startButton {
    background-color: #2f6fed;
    border-color: #2f6fed;
    color: #ffffff;
    font-weight: 600;
}

QPushButton#startButton:hover {
    background-color: #245fd6;
    border-color: #245fd6;
}

QPushButton#startButton:pressed {
    background-color: #1c4fb8;
    border-color: #1c4fb8;
}

QPushButton#startButton:disabled {
    background-color: #c9d6ee;
    border-color: #c9d6ee;
    color: #f4f7fc;
}

QPushButton#cancelButton {
    background-color: #ffffff;
    border-color: #c9d1db;
    color: #344054;
}

QPushButton#cancelButton:hover {
    background-color: #f4f6f8;
    border-color: #98a2b3;
}

QPushButton#cancelButton:pressed {
    background-color: #e9edf2;
    border-color: #98a2b3;
}

QPushButton#cancelButton:disabled {
    background-color: #f0f2f5;
    border-color: #dde2e8;
    color: #a0a7b2;
}

/* ---------- 单行输入框：聚焦高亮、只读态弱化 ---------- */
QLineEdit {
    background-color: #ffffff;
    border: 1px solid #c9d1db;
    border-radius: 6px;
    padding: 5px 8px;
    selection-background-color: #2f6fed;
    selection-color: #ffffff;
}

QLineEdit:focus {
    border-color: #2f6fed;
}

QLineEdit:read-only {
    background-color: #f7f8fa;
    color: #5b6472;
}

/* ---------- 下拉框：通用样式 + 目标格式选择器的高亮样式 ---------- */
QComboBox {
    background-color: #ffffff;
    border: 1px solid #c9d1db;
    border-radius: 6px;
    padding: 4px 8px;
    min-height: 20px;
}

QComboBox:hover {
    border-color: #7aa7e6;
}

QComboBox:focus {
    border-color: #2f6fed;
}

QComboBox::drop-down {
    border: none;
    width: 22px;
}

QComboBox QAbstractItemView {
    background-color: #ffffff;
    border: 1px solid #c9d1db;
    outline: 0;
    selection-background-color: #eef4ff;
    selection-color: #1f2328;
}

QComboBox#formatCombo {
    background-color: #eef4ff;
    border-color: #b7cdf5;
    color: #1a4fa0;
    font-weight: 600;
    padding: 6px 10px;
}

QComboBox#formatCombo:hover {
    border-color: #7aa7e6;
}

QComboBox#formatCombo:focus {
    border-color: #2f6fed;
}

QLabel#fileNameTitle,
QLabel#containerTitle,
QLabel#resolutionTitle,
QLabel#durationTitle,
QLabel#frameRateTitle,
QLabel#codecTitle,
QLabel#sizeTitle,
QLabel#formatTitle,
QLabel#outputDirTitle,
QLabel#outputNameTitle,
QLabel#outputPathTitle,
QLabel#outputStatusTitle {
    color: #667085;
}

QLabel#formatTitle {
    color: #1a4fa0;
    font-weight: 600;
}

QLabel#fileNameValue,
QLabel#containerValue,
QLabel#resolutionValue,
QLabel#durationValue,
QLabel#frameRateValue,
QLabel#codecValue,
QLabel#sizeValue,
QLabel#outputPathLabel,
QLabel#outputStatusLabel {
    color: #1f2328;
}

QLabel#fileNameValue,
QLabel#outputPathLabel {
    font-weight: 500;
}

/* ---------- 转换状态文本：默认灰色，按 state 动态属性切换语义色 ---------- */
QLabel#conversionStatusLabel {
    color: #667085;
    font-weight: 500;
}

QLabel#conversionStatusLabel[state="ready"] {
    color: #1a7f37;
}

QLabel#conversionStatusLabel[state="working"] {
    color: #2f6fed;
}

QLabel#conversionStatusLabel[state="success"] {
    color: #1a7f37;
    font-weight: 600;
}

QLabel#conversionStatusLabel[state="error"] {
    color: #d1242f;
    font-weight: 600;
}

/* ---------- 进度条：细高度、圆角，进度块使用主题蓝 ---------- */
QProgressBar {
    background-color: #e9edf2;
    border: 1px solid #d8dde4;
    border-radius: 7px;
    min-height: 16px;
    max-height: 16px;
    text-align: center;
    color: #1f2328;
}

QProgressBar::chunk {
    background-color: #2f6fed;
    border-radius: 6px;
}

/* ---------- 工具提示：深色底、白字，保证与浅色界面形成对比 ---------- */
QToolTip {
    background-color: #1f2328;
    color: #ffffff;
    border: none;
    padding: 4px 6px;
}
